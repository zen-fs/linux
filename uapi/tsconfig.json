{
	"compilerOptions": {
		"module": "NodeNext",
		"target": "ES2020",
		"rootDir": ".",
		"outDir": "../dist/uapi",
		"lib": ["ESNext", "ESNext.AsyncIterable", "WebWorker"],
		"types": ["node"],
		"strict": true,
		"moduleResolution": "NodeNext",
		"declaration": true,
		"composite": true,
		"verbatimModuleSyntax": true
	},
	"include": ["**/*", "../src/_types.d.ts"],
	"exclude": ["node_modules"]
}
