{
	"compilerOptions": {
		"module": "NodeNext",
		"target": "ES2023",
		"rootDir": "src",
		"outDir": "dist",
		"lib": ["ESNext", "ESNext.AsyncIterable"],
		"strict": true,
		"moduleResolution": "NodeNext",
		"declaration": true,
		"verbatimModuleSyntax": true,
		"types": ["node"]
	},
	"references": [{ "path": "./uapi" }],
	"include": ["src/**/*"],
	"exclude": ["node_modules"]
}
